{
    "name": "@labfeed",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "pnpm --recursive --parallel --if-present dev",
        "build": "pnpm --recursive --if-present build",
        "dev:api": "pnpm --filter @labfeed/api dev",
        "dev:web": "pnpm --filter @labfeed/web dev",
        "build:api": "pnpm --filter @labfeed/api build",
        "build:web": "pnpm --filter @labfeed/web build"
    }
}
